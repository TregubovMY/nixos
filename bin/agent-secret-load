#!/usr/bin/env bash
# Load a secret from Bitwarden into a podman secret, for sidecar
# containers (bin/agent-sidecar) — never for the agent container itself.
# Design and threat model: system-plan.md §9.8.
#
# Bitwarden CLI: `rbw` (the repo had no Bitwarden CLI yet; rbw is in
# nixpkgs and keeps the vault unlocked in its own agent, so loading several
# secrets doesn't re-prompt). Flags below checked against `rbw get --help`
# of rbw 1.15.0: it supports the password, custom fields (`--field`) and a
# JSON dump (`--raw`); it has NO attachment download. Binary material (a
# CryptoPro key container, a .p12) therefore has to be stored in Bitwarden
# as base64 text in a custom field or in the notes, and decoded here with
# `--base64`.
#
# The value goes rbw → pipe → `podman secret create --replace NAME -`: this
# script never writes it to a file or an argument (argv is visible in ps).
# NOTE: podman's default secret driver ("file") itself persists the secret
# in its own storage (~/.local/share/containers/storage/secrets/filedriver,
# mode 0600, on the LUKS-encrypted disk) until `agent-secret-load --rm`.
# That is podman's storage, not a stray copy, but it is on disk — see
# system-plan.md §9.8 for why this was accepted for now and the shell-driver
# alternative that would avoid it.
set -euo pipefail

usage_text="Usage:
  agent-secret-load <secret-name> <bitwarden-item> [--field <name> | --notes] [--base64]
  agent-secret-load --rm <secret-name>

  (default)        the item's password
  --field <name>   a custom field of the item
  --notes          the item's notes
  --base64         decode the value from base64 (binary secrets: key containers, .p12)
  --rm             delete the podman secret"
usage() {
  echo "$usage_text" >&2
  exit 1
}

case "${1:-}" in
  -h | --help)
    echo "$usage_text" >&2
    exit 0
    ;;
esac

command -v podman >/dev/null 2>&1 || { echo "agent-secret-load: podman not found on PATH" >&2; exit 1; }

if [ "${1:-}" = --rm ]; then
  [ "$#" -eq 2 ] || usage
  exec podman secret rm "$2"
fi

[ "$#" -ge 2 ] || usage
name="$1"
item="$2"
shift 2

field=""
notes=0
b64=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --field)
      [ "$#" -ge 2 ] || usage
      field="$2"
      shift
      ;;
    --notes) notes=1 ;;
    --base64) b64=1 ;;
    *) usage ;;
  esac
  shift
done
if [ -n "$field" ] && [ "$notes" = 1 ]; then
  echo "agent-secret-load: --field and --notes are mutually exclusive" >&2
  exit 1
fi

# Secret names become container paths (/run/secrets/<name>) and podman
# object names; keep them boring so neither can be abused.
case "$name" in
  *[!A-Za-z0-9._-]* | "" | .* )
    echo "agent-secret-load: secret name must match [A-Za-z0-9._-]+ and not start with '.': $name" >&2
    exit 1
    ;;
esac

command -v rbw >/dev/null 2>&1 || { echo "agent-secret-load: rbw not found on PATH (Bitwarden CLI)" >&2; exit 1; }

fetch() {
  if [ "$notes" = 1 ]; then
    # `--raw` prints the entry as JSON; the notes live in its top-level
    # "notes" key (rbw 1.15 `--raw` output). jq -e fails on null, so an
    # item without notes is an error, not an empty secret.
    command -v jq >/dev/null 2>&1 || { echo "agent-secret-load: --notes needs jq" >&2; exit 1; }
    rbw get --raw "$item" | jq -er '.notes'
  elif [ -n "$field" ]; then
    rbw get --field "$field" "$item"
  else
    rbw get "$item"
  fi
}

# The fetched text is held only in this shell variable (memory), never in
# a file or in argv. Command substitution also strips rbw's trailing
# newline, which must not become part of the secret. Binary secrets are
# still base64 text at this point (decoded only inside the pipe below),
# so the variable never has to hold NUL bytes.
value="$(fetch)" || { echo "agent-secret-load: rbw could not read '$item' (vault locked? wrong name/field?)" >&2; exit 1; }
if [ -z "$value" ]; then
  echo "agent-secret-load: '$item' returned an empty value — refusing to create an empty secret" >&2
  exit 1
fi

if [ "$b64" = 1 ]; then
  printf '%s' "$value" | base64 -d | podman secret create --replace --label agent-sandbox.source=bitwarden "$name" - >/dev/null
else
  printf '%s' "$value" | podman secret create --replace --label agent-sandbox.source=bitwarden "$name" - >/dev/null
fi
unset value
echo "agent-secret-load: podman secret '$name' updated from Bitwarden item '$item'" >&2
