#!/usr/bin/env bash
# One-shot install of the real mimir host from the NixOS installer ISO.
# Run from the repo root as the ISO's default `nixos` user (passwordless
# sudo), with network up:
#
#   bin/mimir-install /dev/nvme0n1
#
# What it does, in order, and why each step is here rather than in Nix:
# 1. nixos-facter -> hosts/mimir/facter.json. The hardware report replaces
#    a hand-made hardware-configuration.nix (see hosts/mimir/configuration.nix
#    header). It must be `git add`ed: flakes only see tracked files.
# 2. disko destroy,format,mount on the disk given as $1 (disk-config.nix
#    takes the device via --argstr, so nothing about the disk is guessed
#    in the repo). Same pinned disko rev as bin/mimir-full-disko.
# 3. nixos-install with the sbctl-keys retry proven in the VM rehearsals
#    (bin/mimir-full-install has the long explanation: lanzaboote signs
#    the bootloader during nixos-install, so keys must exist in /mnt first;
#    the first attempt is expected to fail exactly there on a fresh disk).
#    --no-root-passwd: root stays locked, admin is via sudo from wheel.
# 4. `passwd max` inside the installed system -- the password is typed by
#    a human and never stored in the repo (no initialPassword/hash).
# 5. Copies this repo, including the fresh facter.json, to
#    /home/max/code/nixos on the new system. The ISO's copy lives in RAM
#    and disappears on reboot; facter.json must survive to be committed.
#
# Secure Boot enrollment (`sbctl enroll-keys`) is NOT done here: it needs
# the firmware in Setup Mode and is safer done from the installed system
# after the first boot. The script prints the remaining steps at the end.
set -euo pipefail

DISKO_REV="ff8702b4de27f72b4c78573dfb89ec74e36abdf1"
NIX_CONFIG='experimental-features = nix-command flakes'
export NIX_CONFIG

die() { echo "mimir-install: $*" >&2; exit 1; }

disk="${1:-}"
[ -n "$disk" ] || die "usage: bin/mimir-install /dev/<disk>   (see lsblk -d)"
[ -b "$disk" ] || die "$disk is not a block device"
[ -f flake.nix ] && [ -d hosts/mimir ] || die "run from the nixos repo root"
# lanzaboote/systemd-boot need a UEFI boot; a legacy-BIOS boot of the ISO
# would get all the way to the bootloader step and fail there.
[ -d /sys/firmware/efi ] || die "the ISO was not booted in UEFI mode"

echo "==> Target disk -- EVERYTHING ON IT WILL BE DESTROYED:"
lsblk -o NAME,SIZE,MODEL,SERIAL,MOUNTPOINTS "$disk"
read -r -p "Type the disk path again to confirm ($disk): " confirm
[ "$confirm" = "$disk" ] || die "confirmation did not match, nothing touched"

echo "==> 1/5 Hardware report (nixos-facter) -> hosts/mimir/facter.json"
# --inputs-from . : nixos-facter from this flake's pinned nixpkgs, i.e. the
# same version whose hardware.facter modules will read the report. Built
# as the invoking user and only *run* as root: root evaluating a flake in
# a git checkout owned by another user can trip git's "dubious ownership"
# check. facter itself needs root to read SMBIOS/PCI details.
facter_out="$(nix build --no-link --print-out-paths --inputs-from . nixpkgs#nixos-facter)"
sudo "$facter_out/bin/nixos-facter" -o hosts/mimir/facter.json
sudo chown "$(id -u):$(id -g)" hosts/mimir/facter.json
[ -s hosts/mimir/facter.json ] || die "facter.json was not produced"
git add hosts/mimir/facter.json

echo "==> 2/5 Partitioning $disk (disko: LUKS + btrfs; you'll set the LUKS passphrase)"
# --yes-wipe-all-disks: the human already confirmed above by retyping the
# path; disko's own prompt would only ask the same question again.
sudo NIX_CONFIG="$NIX_CONFIG" nix run "github:nix-community/disko/${DISKO_REV}" -- \
  --mode destroy,format,mount --yes-wipe-all-disks \
  --argstr device "$disk" \
  ./hosts/mimir/disk-config.nix

echo "==> 3/5 nixos-install .#mimir (first attempt may fail at the bootloader step -- expected)"
if ! sudo NIX_CONFIG="$NIX_CONFIG" nixos-install --no-root-passwd --flake .#mimir; then
  echo "==> Creating Secure Boot keys inside /mnt and retrying"
  sudo nixos-enter --root /mnt -c 'sbctl create-keys'
  sudo NIX_CONFIG="$NIX_CONFIG" nixos-install --no-root-passwd --flake .#mimir
fi

echo "==> 4/5 Password for user max"
until sudo nixos-enter --root /mnt -c 'passwd max'; do
  echo "passwd failed, try again"
done

echo "==> 5/5 Copying this repo (with facter.json) to /home/max/code/nixos"
sudo mkdir -p /mnt/home/max/code
sudo cp -a . /mnt/home/max/code/nixos
# max's uid/gid as the installed system sees them, not the ISO's.
owner="$(sudo nixos-enter --root /mnt -c 'echo "$(id -u max):$(id -g max)"' | tail -n1)"
sudo chown -R "$owner" /mnt/home/max/code

cat <<'EOF'

==> Done. Next steps (also in README, "Установка на реальную машину"):
  1. reboot, remove the USB stick, enter the LUKS passphrase, log in as max.
  2. Secure Boot: in the firmware setup, reset Secure Boot to Setup Mode,
     boot NixOS, then:   sudo sbctl enroll-keys --microsoft
     reboot, enable Secure Boot in the firmware, check: bootctl status
  3. cd ~/code/nixos && git commit hosts/mimir/facter.json && git push
  4. Throne: import the VLESS config from Bitwarden, then set
     desktopApps.rubymine.enable = true in hosts/mimir/configuration.nix
     and run: sudo nixos-rebuild switch --flake .#mimir
EOF
