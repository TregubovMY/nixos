#!/usr/bin/env bash
# ai -- start claude-code in the right place with one command.
#
#   ai [claude args...]      directly on the host, in this folder
#   ai --vm      [args...]   in the agent microVM (agent-vm: own Docker, internet only), in this folder;
#                            the folder must be in agentVm.mounts
#   ai --account NAME ...    run this one invocation under Claude account NAME (claude-use)
#
# Sessions are the same wherever it runs: claude-code keys transcripts by
# working directory, the VM mounts projects at their host paths, and all
# accounts share one projects/ tree (bin/claude-use). So `ai` in a folder and
# later `ai --vm` there see the same conversations (`ai --continue`).
# (agent-sandbox modes --sandbox/auto moved to the `agent-sandbox` branch, 2026-11-02.)
#
# Our options must come first; everything after them goes to claude verbatim.
# Long options only on purpose: claude has many short ones (-c, -p, -r, ...).
set -euo pipefail

where=host
account=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --host) where=host ;;
    --vm) where=vm ;;
    --account)
      [ "$#" -ge 2 ] || { echo "ai: --account needs a name" >&2; exit 2; }
      account="$2"; shift
      ;;
    -h | --help)
      sed -n '2,/^set -euo/p' "$0" | sed -e '$d' -e 's/^# \{0,1\}//' >&2
      exit 0
      ;;
    --) shift; break ;;
    *) break ;;
  esac
  shift
done

env_args=()
[ -z "$account" ] || env_args=(env "CLAUDE_ACCOUNT=$account")

case "$where" in
  host)
    # The wrapper by absolute path, not whatever `claude` PATH finds first:
    # mise puts a node's bin dir ahead of it, and a claude-code that landed
    # there (Claude Code's self-update installs into the node it runs under,
    # 2026-10-22) has no CLAUDE_CONFIG_DIR -> pre-accounts ~/.claude -> login.
    # AI_CLAUDE overrides the path (tests/ai-test.sh has no /run/current-system).
    exec "${env_args[@]}" "${AI_CLAUDE:-/run/current-system/sw/bin/claude}" "$@"
    ;;
  vm)
    # --account goes as agent-vm's own option: the remote side reads
    # CLAUDE_ACCOUNT from the command line it builds, not from this env.
    if [ -n "$account" ]; then exec agent-vm claude --account "$account" "$@"; fi
    exec agent-vm claude "$@"
    ;;
esac
