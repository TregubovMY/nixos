#!/usr/bin/env bash
# Wrapper around `podman run`/`podman exec` for the agent-sandbox image.
# Only the target project directory is ever mounted in — see
# system-plan.md §9.2 for why (blast-radius containment between projects,
# not a network security boundary — networking is deliberately left open).
#
# Two ways to run (system-plan.md §9.4, §9.7):
# - one-shot (the original mode, unchanged): `agent-sandbox <dir> [-- cmd]`
#   — a fresh `--rm` container per invocation;
# - long-lived per project: `up` starts one named container per project
#   and keeps it running; `attach`/`exec` run commands inside it; `down`
#   stops it. Needed by anything that has to outlive one command: the
#   the dsh Web UI, tmux sessions.
set -euo pipefail

usage_text="Usage:
  agent-sandbox [options] <project-dir> [-- command...]   one-shot container (--rm)
  agent-sandbox up [options] <project-dir>                start the long-lived project container
  agent-sandbox attach [--workdir P] <project-dir> [-- command...]
                                                          interactive shell/command in it (TTY)
  agent-sandbox exec [--workdir P] [--no-tty] <project-dir> -- command...
                                                          run a command in it, exit code passed through
  agent-sandbox down <project-dir>                        stop (and remove) it
  agent-sandbox status [<project-dir>]                    list running project containers

<project-dir> can be @name: settings from ~/.config/agent-sandbox/projects/<name>.conf
(main dir, extra dirs, env, ports) — see the comment in this script.

Options (one-shot and up):
  --gui                   Wayland + GPU passthrough (see agent-sandbox-gui.sh)
  --workdir <path>        start in a subdirectory of the project, e.g. .worktrees/feature/KEY-slug
                          (one-shot/attach/exec only)
  --no-tty                never allocate a TTY (scripts/orchestrators), even when run from a terminal
  --publish <host>:<ctr>  publish a container port on 127.0.0.1 of the host only (repeatable)
  --gitlab-token          pass GITLAB_TOKEN through (off by default; project-scoped token only)
  --shared-root           acknowledge that <project-dir> holds several projects (up only):
                          every project under it becomes visible to every agent in the container"
usage() {
  echo "$usage_text" >&2
  exit 1
}

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------

mode=run
case "${1:-}" in
  up | attach | exec | down | status)
    mode="$1"
    shift
    ;;
esac

gui=0
workdir_arg=""
no_tty=0
gitlab_token=0
shared_root=0
publish=()

# Options come before <project-dir>. Parsed in a loop (not the single
# positional `--gui` check this script started with), because there are
# now several and their order shouldn't matter.
while [ "$#" -gt 0 ]; do
  case "$1" in
    --gui) gui=1 ;;
    --workdir)
      [ "$#" -ge 2 ] || usage
      workdir_arg="$2"
      shift
      ;;
    --no-tty) no_tty=1 ;;
    --gitlab-token) gitlab_token=1 ;;
    --shared-root) shared_root=1 ;;
    --publish)
      [ "$#" -ge 2 ] || usage
      publish+=("$2")
      shift
      ;;
    # `-h`/`--help` (final review, M1) handled while parsing options, so
    # `agent-sandbox --gui --help` is caught too, and before the podman
    # check below (re-review nit): otherwise `agent-sandbox --help` on a
    # host without podman installed prints the podman-missing error
    # instead of usage text. Without this branch at all, "--help" would
    # fall through to become $project_dir, `cd --help` prints bash's
    # builtin help to stdout (silently swallowed by the command
    # substitution below) and returns exit 2, which `set -e` then turns
    # into a silent, message-less exit.
    -h | --help)
      echo "$usage_text" >&2
      exit 0
      ;;
    --) break ;;
    -*)
      echo "agent-sandbox: unknown option: $1" >&2
      usage
      ;;
    *) break ;;
  esac
  shift
done

# Reject options that make no sense for the chosen mode instead of
# silently ignoring them — a silently dropped `--workdir` would run an
# agent in the project root instead of its worktree.
case "$mode" in
  up)
    [ -z "$workdir_arg" ] || { echo "agent-sandbox up: --workdir applies to attach/exec, not up" >&2; exit 1; }
    ;;
  attach | exec)
    if [ "$gui" = 1 ] || [ "$gitlab_token" = 1 ] || [ "${#publish[@]}" -gt 0 ] || [ "$shared_root" = 1 ]; then
      echo "agent-sandbox $mode: --gui/--publish/--gitlab-token/--shared-root are fixed at 'up' time" >&2
      exit 1
    fi
    ;;
  down | status)
    if [ "$gui" = 1 ] || [ -n "$workdir_arg" ] || [ "$no_tty" = 1 ] || [ "$gitlab_token" = 1 ] ||
      [ "${#publish[@]}" -gt 0 ] || [ "$shared_root" = 1 ]; then
      echo "agent-sandbox $mode: takes no options" >&2
      exit 1
    fi
    ;;
  run)
    [ "$shared_root" = 0 ] || { echo "agent-sandbox: --shared-root applies to 'up' only" >&2; exit 1; }
    ;;
esac

# `command -v podman` check up front (final review, M9): without this, a
# host that never ran Task 1's build/load step gets a bare "podman:
# command not found" from the final `exec` far below, with no pointer
# back to the README's prerequisites section. Fail fast with an
# actionable message instead.
command -v podman >/dev/null 2>&1 || {
  echo "agent-sandbox: podman not found on PATH (modules/nixos/podman.nix)" >&2
  exit 1
}

# The sandbox root (since 2026-10-06 a directory in /nix/store, not an
# image -- modules/nixos/packages/agent-sandbox.nix). The host module
# links it at /etc/agent-sandbox/rootfs; AGENT_SANDBOX_ROOTFS overrides it
# for testing a build without switching (`nix build .#agent-sandbox-rootfs`).
# Resolved to the real store path because podman --rootfs needs a
# directory, and so a later switch can't change it under a running
# container. Only needed by run/up; attach/exec/down/status don't use it.
resolve_rootfs() {
  local link="${AGENT_SANDBOX_ROOTFS:-/etc/agent-sandbox/rootfs}"
  rootfs="$(readlink -f "$link" 2>/dev/null || true)"
  if [ -z "$rootfs" ] || [ ! -e "$rootfs/agent-entrypoint" ]; then
    echo "agent-sandbox: no sandbox rootfs at $link -- enable modules/nixos/agent-sandbox.nix" \
         "(nixos-rebuild switch) or point AGENT_SANDBOX_ROOTFS at a build" >&2
    exit 1
  fi
}

if [ "$mode" = status ] && [ "$#" -eq 0 ]; then
  exec podman ps --filter label=agent-sandbox.project \
    --format '{{.Names}}\t{{.Status}}\t{{index .Labels "agent-sandbox.project"}}'
fi

project_dir="${1:-}"
[ -n "$project_dir" ] || usage
shift

# ---------------------------------------------------------------------------
# Per-project config: `@name` instead of <project-dir>
# ---------------------------------------------------------------------------
# ~/.config/agent-sandbox/projects/<name>.conf, `key = value` per line:
#   dir      = ~/code/shop-api          main project -> /workspace (required, once)
#   mount    = ~/code/shop-frontend     extra dir, read-write, same path inside (repeatable)
#   mount_ro = ~/code/shared-lib        extra dir, read-only, same path inside (repeatable)
#   publish  = 3080:3080                like --publish, 127.0.0.1 only (repeatable)
#   env      = RAILS_ENV=development    literal variable (repeatable; NOT for secrets)
#
# Why outside the project and not a dotfile in it: the project dir is
# mounted read-write, so an agent could edit such a file and grant itself
# more directories on the next start. The config is read here, on the
# host, and the script refuses one that lives inside any directory it
# mounts. Parsed line by line, never `source`d: it is data, and a
# sourced file would be a second way to run arbitrary code on the host.
# Extra dirs keep their host path inside the container (same rule as
# bin/kandev-sandbox), so paths an agent mentions are paths the host IDE
# can open; only the main dir is /workspace, as before.
cfg_name=""
cfg_mounts=()
cfg_mounts_ro=()
cfg_env=()

cfg_path() { # expand a leading ~ and resolve to a physical dir, or die
  local p="$1"
  case "$p" in "~") p="$HOME" ;; "~/"*) p="$HOME/${p#"~/"}" ;; esac
  case "$p" in
    *:*) echo "agent-sandbox: path in $cfg_file must not contain ':': $p" >&2; exit 1 ;;
  esac
  [ -d "$p" ] || { echo "agent-sandbox: not a directory (in $cfg_file): $p" >&2; exit 1; }
  p="$(cd "$p" && pwd -P)"
  # Mounting / or the whole home would hand the agent SSH keys, browser
  # profiles, other projects — what the sandbox exists to hide.
  if [ "$p" = / ] || [ "$p" = "$(cd "$HOME" && pwd -P)" ]; then
    echo "agent-sandbox: refusing to mount $p (from $cfg_file) — list project directories" >&2
    exit 1
  fi
  printf '%s' "$p"
}

case "$project_dir" in
  @*)
    cfg_name="${project_dir#@}"
    case "$cfg_name" in
      "" | *[!a-z0-9_-]* | [_-]*)
        echo "agent-sandbox: config name must be [a-z0-9_-]: @$cfg_name" >&2
        exit 1
        ;;
    esac
    cfg_file="${XDG_CONFIG_HOME:-$HOME/.config}/agent-sandbox/projects/$cfg_name.conf"
    [ -f "$cfg_file" ] || { echo "agent-sandbox: no config $cfg_file" >&2; exit 1; }
    project_dir=""
    lineno=0
    while IFS= read -r line || [ -n "$line" ]; do
      lineno=$((lineno + 1))
      line="${line%%#*}"
      # trim surrounding whitespace
      line="${line#"${line%%[![:space:]]*}"}"
      line="${line%"${line##*[![:space:]]}"}"
      [ -n "$line" ] || continue
      case "$line" in
        *=*) ;;
        *) echo "agent-sandbox: $cfg_file:$lineno: expected 'key = value'" >&2; exit 1 ;;
      esac
      key="${line%%=*}"; key="${key%"${key##*[![:space:]]}"}"
      val="${line#*=}"; val="${val#"${val%%[![:space:]]*}"}"
      case "$key" in
        dir)
          [ -z "$project_dir" ] || { echo "agent-sandbox: $cfg_file:$lineno: 'dir' given twice" >&2; exit 1; }
          project_dir="$(cfg_path "$val")"
          ;;
        mount) cfg_mounts+=("$(cfg_path "$val")") ;;
        mount_ro) cfg_mounts_ro+=("$(cfg_path "$val")") ;;
        publish)
          # Only from the config when the container is actually created;
          # attach/exec/down reuse what `up` set (see the mode checks above).
          case "$mode" in run | up) publish+=("$val") ;; esac
          ;;
        env)
          case "$val" in
            [A-Za-z_]*=*) cfg_env+=("$val") ;;
            *) echo "agent-sandbox: $cfg_file:$lineno: env expects NAME=value" >&2; exit 1 ;;
          esac
          ;;
        *) echo "agent-sandbox: $cfg_file:$lineno: unknown key '$key'" >&2; exit 1 ;;
      esac
    done <"$cfg_file"
    [ -n "$project_dir" ] || { echo "agent-sandbox: $cfg_file has no 'dir = ...'" >&2; exit 1; }
    # The config must not be reachable (writable) from inside the container.
    cfg_real="$(cd "$(dirname "$cfg_file")" && pwd -P)/$(basename "$cfg_file")"
    for d in "$project_dir" ${cfg_mounts[@]+"${cfg_mounts[@]}"}; do
      case "$cfg_real" in
        "$d"/*)
          echo "agent-sandbox: $cfg_file lies inside mounted dir $d — an agent could rewrite it; move it out" >&2
          exit 1
          ;;
      esac
    done
    ;;
esac

# A project path containing ':' would silently corrupt the `-v
# host:container` volume spec built below (podman splits on ':') —
# reject it up front with a clear error instead of a confusing bind-mount
# failure later (final review, M4).
case "$project_dir" in
  *:*)
    echo "agent-sandbox: project directory path must not contain ':'" \
         "(breaks the podman -v volume spec): $project_dir" >&2
    exit 1
    ;;
esac

# Resolve to an absolute, *physical* path (`pwd -P`, not logical `pwd`)
# so relative paths like "." work regardless of where agent-sandbox is
# invoked from, and so a symlinked project path always hashes to the
# same project_hash/cache volume as its real path (final review, M4) —
# plain `pwd` would resolve through the symlink and give the two paths
# different hashes.
project_dir="$(cd "$project_dir" && pwd -P)"

# Per-project cache volume name, so two different projects' agent
# session/index caches never collide or leak into each other. Also names
# the long-lived `up` container, so one project maps to exactly one.
project_hash="$(printf '%s' "$project_dir" | sha256sum | cut -c1-12)"
# A config project is keyed by its name instead: moving the directory and
# editing `dir =` keeps the same claude/opencode logins and caches. The
# "cfg-" prefix keeps the namespace apart from the hex path hashes.
[ -z "$cfg_name" ] || project_hash="cfg-$cfg_name"
container_name="agent-sandbox-$project_hash"

# Strip a single leading "--" from the remaining args before forwarding
# them to the container. Before the image entrypoint switched to
# `exec mise exec -- "$@"` (commit 1a3f550), this didn't matter: bash's
# own `exec` builtin silently swallows a literal "--" as its first word
# (verified: `bash -c 'set -- -- echo hi; exec "$@"'` prints "hi"). Now
# that `mise` is the first word after `exec`, that swallowing no longer
# happens, so `mise exec` receives a literal "--" and chokes on it
# ("mise ERROR \"--\" couldn't exec process"). This is the documented
# `agent-sandbox <dir> -- <command>` separator, not something meant to
# reach the container's CMD.
if [ "${1:-}" = "--" ]; then
  shift
fi

# --workdir: a path inside the project, given either relative to the
# project root (`.worktrees/feature/KEY-slug`) or as an absolute host path
# under it. Resolved on the host with `pwd -P` and checked to still be
# inside $project_dir *after* symlink resolution, so neither `..` nor a
# symlink can point the agent at a directory the container can't see
# anyway (it would only fail later, less clearly). Passed to the image
# entrypoint as AGENT_WORKDIR, which re-validates it (defence in depth,
# see modules/nixos/packages/agent-sandbox.nix).
container_workdir=""
if [ -n "$workdir_arg" ]; then
  case "$workdir_arg" in
    /*) host_workdir="$workdir_arg" ;;
    *) host_workdir="$project_dir/$workdir_arg" ;;
  esac
  if [ ! -d "$host_workdir" ]; then
    echo "agent-sandbox: --workdir does not exist: $host_workdir" >&2
    exit 1
  fi
  host_workdir="$(cd "$host_workdir" && pwd -P)"
  case "$host_workdir" in
    "$project_dir") container_workdir=/workspace ;;
    "$project_dir"/*) container_workdir="/workspace/${host_workdir#"$project_dir"/}" ;;
    *)
      echo "agent-sandbox: --workdir must be inside the project directory ($project_dir): $host_workdir" >&2
      exit 1
      ;;
  esac
fi

# TTY vs non-TTY (final review, I6): `-it` was previously passed
# unconditionally, which breaks the documented non-interactive
# `agent-sandbox <dir> -- <command>` form used from scripts/pipelines —
# with no TTY on stdin, Docker-family frontends either mangle output
# (CRLF, merged streams) or fail outright ("the input device is not a
# TTY"). Only request a TTY when both stdin and stdout are actually
# TTYs; otherwise stay with plain `-i` so piped/redirected invocations
# keep working. `--no-tty` forces the non-TTY path even from a terminal:
# an orchestrator (forge) started interactively still wants the agent's
# stream-json output on a clean pipe, not through a pseudo-terminal.
if [ "$no_tty" = 0 ] && [ -t 0 ] && [ -t 1 ]; then
  tty_args=(-it)
else
  tty_args=(-i)
fi

# Environment passthrough is an explicit allowlist, never `--env-host`/
# `--env-file`: the container gets exactly the variables named below and
# nothing else from the host environment. In particular Jira/GitLab/other
# service tokens that happen to be exported in the host shell never reach
# an agent that reads untrusted ticket text with an open network
# (system-plan.md §9.7). tests/agent-sandbox-test.sh asserts this.
#
# `-e VAR` with no `=value` forwards the host's current value into the
# container (podman/docker convention), and only added when actually set
# on the host so an unset var doesn't punch a hole through to an empty
# string inside the container.
env_args=()
# Optional API-key auth, alternative to the OAuth-style `claude login`
# session persisted via the agent-creds volume below.
if [ -n "${ANTHROPIC_API_KEY:-}" ]; then
  env_args+=(-e ANTHROPIC_API_KEY)
fi
# Same passthrough, for DeepSeek Harness (`dsh`) -- it refuses to do
# anything without a DeepSeek API key (see README's DeepSeek Harness
# section).
if [ -n "${DEEPSEEK_API_KEY:-}" ]; then
  env_args+=(-e DEEPSEEK_API_KEY)
fi
# GitLab: opt-in per invocation, never implicit. Meant for a GitLab
# *Project* Access Token (one project, Developer role, expiry, protected
# main) once the GitLab stage is enabled — see system-plan.md §9.7 for why
# a broader personal token must not be passed here.
if [ "$gitlab_token" = 1 ]; then
  if [ -z "${GITLAB_TOKEN:-}" ]; then
    echo "agent-sandbox: --gitlab-token given but GITLAB_TOKEN is not set" >&2
    exit 1
  fi
  env_args+=(-e GITLAB_TOKEN)
fi

# --publish <host>:<container>: always bound to 127.0.0.1 on the host,
# never 0.0.0.0 — a web UI running next to an agent (dsh web, a board)
# must not be reachable from the LAN.
publish_args=()
for p in ${publish[@]+"${publish[@]}"}; do
  case "$p" in
    [0-9]*:[0-9]*)
      host_port="${p%%:*}"
      ctr_port="${p#*:}"
      case "$host_port$ctr_port" in
        *[!0-9]*)
          echo "agent-sandbox: --publish expects <host-port>:<container-port>: $p" >&2
          exit 1
          ;;
      esac
      publish_args+=(-p "127.0.0.1:$host_port:$ctr_port")
      ;;
    *)
      echo "agent-sandbox: --publish expects <host-port>:<container-port>: $p" >&2
      exit 1
      ;;
  esac
done

# ---------------------------------------------------------------------------
# attach / exec / down / status: act on the running `up` container
# ---------------------------------------------------------------------------

require_running() {
  if [ "$(podman container inspect -f '{{.State.Running}}' "$container_name" 2>/dev/null || true)" != true ]; then
    echo "agent-sandbox $mode: no running container for $project_dir" \
         "(expected $container_name) — start it with: agent-sandbox up $project_dir" >&2
    exit 1
  fi
}

case "$mode" in
  status)
    exec podman ps --filter "name=^$container_name\$" \
      --format '{{.Names}}\t{{.Status}}\t{{index .Labels "agent-sandbox.project"}}'
    ;;
  down)
    # `up` starts the container with --rm, so stopping it also removes it;
    # the named volumes (creds, cache, mise, ...) are untouched.
    exec podman stop "$container_name"
    ;;
  attach | exec)
    require_running
    if [ "$mode" = attach ]; then
      exec_tty=(-it)
    else
      exec_tty=("${tty_args[@]}")
      [ "$#" -gt 0 ] || { echo "agent-sandbox exec: a command is required after --" >&2; exit 1; }
    fi
    exec_env=()
    [ -z "$container_workdir" ] || exec_env+=(-e "AGENT_WORKDIR=$container_workdir")
    # `podman exec` does not run the image Entrypoint, so the command goes
    # through it explicitly via its fixed symlink (/agent-entrypoint, see
    # modules/nixos/packages/agent-sandbox.nix) — otherwise HOME, PATH to
    # the npm/uv/local-bin volumes, nix-ld and mise would all be missing.
    # The exit status of the command is podman exec's own exit status
    # (podman itself only uses 125-127 for its own errors).
    exec podman exec "${exec_tty[@]}" ${exec_env[@]+"${exec_env[@]}"} "$container_name" /agent-entrypoint "$@"
    ;;
esac

# ---------------------------------------------------------------------------
# run (one-shot) / up (long-lived): build the `podman run` invocation
# ---------------------------------------------------------------------------

if [ "$mode" = up ]; then
  if [ "$#" -gt 0 ]; then
    echo "agent-sandbox up: takes no command (use attach/exec afterwards)" >&2
    exit 1
  fi
  if [ "$(podman container inspect -f '{{.State.Running}}' "$container_name" 2>/dev/null || true)" = true ]; then
    echo "agent-sandbox up: already running: $container_name ($project_dir)" >&2
    exit 0
  fi
  if [ "$shared_root" = 1 ]; then
    echo "agent-sandbox up --shared-root: every project under $project_dir is visible to every" \
         "agent in this container — per-project isolation (system-plan.md §9.2) does not apply." >&2
  fi
  args=(
    podman run --rm -d
    --name "$container_name"
    --label "agent-sandbox.project=$project_dir"
    # PID 1 of a long-lived container has to reap orphans (tmux servers,
    # agent CLIs spawned by a daemon and detached from their `exec`);
    # `sleep` below would not. `--init` puts podman's catatonit there.
    --init
  )
else
  args=(podman run --rm "${tty_args[@]}")
fi

args+=(
  --userns=keep-id
  -v "$project_dir:/workspace"
  # Per-project persistent HOME. Containers are --rm, so without this
  # everything an agent or you put in ~ outside the volumes below (shell
  # history, ~/.gitconfig, ~/.dsh with dsh plugins/sessions, tool configs)
  # was gone after every down/up. The shared volumes below are mounted on
  # top of it at their subpaths (podman mounts parents first), so they
  # stay shared between projects as before. Per project, not shared, for
  # the same blast-radius reason as agent-creds below. The image's own
  # /home/agent is empty (chmod 777, see agent-sandbox.nix extraCommands),
  # so the volume never freezes stale image content; the entrypoint
  # re-creates its symlinks idempotently on every start.
  -v "agent-home-$project_hash:/home/agent"
  -v "agent-mise:/home/agent/.local/share/mise"
  # Shared across projects, same as agent-mise above and for the same
  # reason (system-plan.md §9.6): `uv tool install "notebooklm-py[browser]"`
  # is a user-level install, not project data, so re-running it on every
  # single container restart for every project would be wasteful. Entry
  # point (modules/nixos/packages/agent-sandbox.nix) points UV_TOOL_DIR/
  # UV_TOOL_BIN_DIR at this one mounted path.
  -v "agent-uv-tools:/home/agent/.local/share/uv"
  # Shared across projects, same reasoning as agent-uv-tools right above:
  # `npm install -g @deepseek-ai/dsh` (DeepSeek Harness) is a user-level
  # install, not project data. Entry point (modules/nixos/packages/
  # agent-sandbox.nix) points NPM_CONFIG_PREFIX at this one mounted path.
  -v "agent-npm-global:/home/agent/.local/share/npm-global"
  # Shared across projects, same reasoning again, for single prebuilt
  # binaries installed by hand from GitHub releases — the entrypoint
  # puts ~/.local/bin on PATH.
  -v "agent-local-bin:/home/agent/.local/bin"
  -v "agent-cache-$project_hash:/home/agent/.cache"
  # Per-project (not shared) credentials volume, keyed by the same
  # project_hash as the cache volume above. A single shared volume was
  # rejected on purpose (README "Известные ограничения"): it would make
  # one project's sandbox able to read every other project's Claude/
  # opencode session, defeating the whole point of per-project blast-
  # radius containment this script's header comment describes. Per-project
  # still means "claude login"/"opencode auth" once per NEW project, but
  # not on every single container restart of the SAME project -- the
  # actual pain this was fixing. The real path->volume wiring (symlinking
  # ~/.claude, ~/.claude.json, ~/.config/opencode into this one mount) is
  # the entrypoint's job (modules/nixos/packages/agent-sandbox.nix),
  # not this script's -- a single volume here keeps the podman invocation
  # from growing one flag per credential file/dir.
  -v "agent-creds-$project_hash:/home/agent/.sandbox-creds"
  --network=bridge
)
args+=(${env_args[@]+"${env_args[@]}"} ${publish_args[@]+"${publish_args[@]}"})

# Config extras (see the `@name` block above). Extra dirs are also
# exported as AGENT_EXTRA_TRUSTED so the entrypoint lets mise read their
# mise.toml without a trust prompt, like it does for /workspace.
extra_trusted=()
for d in ${cfg_mounts[@]+"${cfg_mounts[@]}"}; do
  args+=(-v "$d:$d"); extra_trusted+=("$d")
done
for d in ${cfg_mounts_ro[@]+"${cfg_mounts_ro[@]}"}; do
  args+=(-v "$d:$d:ro"); extra_trusted+=("$d")
done
if [ "${#extra_trusted[@]}" -gt 0 ]; then
  args+=(-e "AGENT_EXTRA_TRUSTED=$(IFS=:; echo "${extra_trusted[*]}")")
fi
for e in ${cfg_env[@]+"${cfg_env[@]}"}; do
  args+=(-e "$e")
done

[ -z "$container_workdir" ] || args+=(-e "AGENT_WORKDIR=$container_workdir")

if [ "$gui" = 1 ]; then
  # `readlink -f "${BASH_SOURCE[0]}"`, not `dirname "$0"` (final review,
  # M2): `$0` is the invoking name, which is the *symlink* itself if the
  # user put `agent-sandbox` on PATH via a symlink to this repo — its
  # dirname then doesn't contain agent-sandbox-gui.sh. BASH_SOURCE[0] is
  # this script's own path (same problem via a symlink), and
  # `readlink -f` resolves through the symlink to the real file's
  # directory either way.
  # shellcheck disable=SC1091
  source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/agent-sandbox-gui.sh"
fi

# Run from the rootfs directory instead of an image:
# - --rootfs DIR:O -- DIR is the first positional; ":O" overlays it, so
#   podman can create its mount points (/etc/hosts, ...) although DIR is
#   in the read-only store; nothing written there outlives the container;
# - /nix/store read-only: every tool and every symlink in the rootfs
#   points into it -- the host's own store, shared, not copied;
# - /tmp as tmpfs (the rootfs is read-only);
# - --passwd-entry: podman adds the keep-id user to /etc/passwd itself
#   (getpwuid() must work for git/ssh/mise); HOME comes from it;
# - /agent-entrypoint is called explicitly: a rootfs has no image config.
resolve_rootfs
# $UID/$GID in --passwd-entry are podman's own template variables, hence
# single quotes.
# shellcheck disable=SC2016
args+=(
  -v /nix/store:/nix/store:ro
  --tmpfs /tmp:rw,mode=1777
  --passwd-entry 'agent:*:$UID:$GID::/home/agent:/bin/bash'
  -w /workspace
  --rootfs "$rootfs:O"
)
if [ "$mode" = up ]; then
  # The container's own command just keeps it alive; everything useful
  # runs through `attach`/`exec`. It still goes through the entrypoint,
  # so `mise install` for the project happens once here at `up` time.
  args+=(/agent-entrypoint sleep infinity)
else
  args+=(/agent-entrypoint "$@")
fi

exec "${args[@]}"
