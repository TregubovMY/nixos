#!/usr/bin/env bash
# agent-sandbox -- run AI agents in a rootless-podman sandbox that sees only
# the project directories you list (system-plan.md §9).
#
# Model: a sandbox is a NAMED GROUP of projects of one trust level, defined
# by a config file (below), not a single directory. One long-lived container
# per group; every project of the group is mounted at the SAME PATH as on
# the host. That one rule buys three things:
#   - claude-code keys its session transcripts by working directory, so a
#     session started on the host can be resumed in the sandbox and back
#     (there is no /workspace any more -- it made the paths differ);
#   - paths in logs, errors and stack traces are paths the host IDE opens;
#   - "the folder you opened the agent in" is simply your cwd.
#
#   agent-sandbox [@name] [-- command...]   enter: start the sandbox if needed, run
#                                            the command (default: a shell) in the
#                                            directory you are in; @name is guessed
#                                            from the cwd when omitted
#   agent-sandbox up [@name]                 start it (detached), run its autostart commands
#   agent-sandbox down [@name]               stop it (volumes with data stay)
#   agent-sandbox status                     list running sandboxes
#   agent-sandbox which                      name of the sandbox covering the cwd (exit 1: none)
#   agent-sandbox --here [-- command...]     one-off sandbox for exactly the cwd, no config needed
set -euo pipefail

usage_text="Usage:
  agent-sandbox [options] [@name] [-- command...]   run a command (default: shell) in the sandbox,
                                                    starting it first if it is not running
  agent-sandbox up [options] [@name]                start it in the background
  agent-sandbox down [@name]                        stop it
  agent-sandbox status                              list running sandboxes
  agent-sandbox which                               print the sandbox that covers the current directory
                                                    (exit 1 if none)

@name: ~/.config/agent-sandbox/projects/<name>.conf (see the comment in this script).
Without @name the sandbox whose directories contain the current directory is used.

Options:
  --here            a sandbox for exactly the current directory, no config file (any folder;
                    sessions stay shared with the host: same path, same account tree)
  -C <dir>          start in <dir> (a host path inside the sandbox) instead of the cwd
  --no-tty          never allocate a TTY (scripts/orchestrators)
  --gui             Wayland + GPU passthrough (fixed when the sandbox is created)
  --gitlab-token    pass GITLAB_TOKEN through (fixed at creation; Project Access Token only)"
usage() {
  echo "$usage_text" >&2
  exit 1
}

die() { echo "agent-sandbox: $*" >&2; exit 1; }

# ---------------------------------------------------------------------------
# Arguments
# ---------------------------------------------------------------------------

mode=enter
case "${1:-}" in
  up | down | status | which)
    mode="$1"
    shift
    ;;
esac

gui=0
no_tty=0
gitlab_token=0
here_mode=0
start_dir=""
target=""

while [ "$#" -gt 0 ]; do
  case "$1" in
    --gui) gui=1 ;;
    --no-tty) no_tty=1 ;;
    --gitlab-token) gitlab_token=1 ;;
    --here) here_mode=1 ;;
    -C)
      [ "$#" -ge 2 ] || usage
      start_dir="$2"
      shift
      ;;
    # Handled while parsing, before the podman check below, so `--help`
    # works on a host without podman.
    -h | --help)
      echo "$usage_text" >&2
      exit 0
      ;;
    --) break ;;
    @*)
      [ -z "$target" ] || die "more than one @name given"
      target="${1#@}"
      ;;
    -*) die "unknown option: $1" ;;
    *) die "unexpected argument: $1 (sandboxes are configs: use @name; a command goes after --)" ;;
  esac
  shift
done
# A single leading "--" separates our options from the command. It must not
# reach the container: the entrypoint execs `mise exec -- "$@"`, which would
# receive a literal "--" and fail ("couldn't exec process").
if [ "${1:-}" = "--" ]; then
  shift
fi

# Reject options that make no sense for the mode instead of ignoring them.
case "$mode" in
  down | status | which)
    if [ "$here_mode" = 1 ] || [ "$gui" = 1 ] || [ "$no_tty" = 1 ] || [ "$gitlab_token" = 1 ] || [ -n "$start_dir" ]; then
      die "$mode takes no options"
    fi
    ;;
  up)
    [ "$here_mode" = 0 ] || die "up: --here is for running a command (the sandbox is created on first use)"
    [ -z "$start_dir" ] || die "up: -C applies to running a command, not to starting"
    [ "$no_tty" = 0 ] || die "up: --no-tty applies to running a command"
    ;;
esac
if [ "$mode" != enter ] && [ "$#" -gt 0 ]; then
  die "$mode takes no command"
fi

# Fail early with a pointer instead of a bare "command not found" from the
# final exec far below.
command -v podman >/dev/null 2>&1 || die "podman not found on PATH (modules/nixos/podman.nix)"

if [ "$mode" = status ]; then
  exec podman ps --filter label=agent-sandbox.name \
    --format '{{.Names}}\t{{.Status}}\t{{index .Labels "agent-sandbox.name"}}'
fi

# ---------------------------------------------------------------------------
# Config: ~/.config/agent-sandbox/projects/<name>.conf, `key = value` per line
# ---------------------------------------------------------------------------
#   rw        = ~/code/my          project dir, read-write, same path inside (repeatable, >= 1)
#   ro        = ~/code/shared-lib  project dir, read-only (repeatable)
#   account   = work               Claude account claude-code starts under (claude-use, bin/claude-use);
#                                  optional -- without it the host's rules decide
#   publish   = 3080:3080          like docker -p, but 127.0.0.1 only (repeatable)
#   env       = RAILS_ENV=dev      literal variable (repeatable; NOT for secrets)
#   autostart = kandev start ...   command started in the background by `up` (repeatable)
# The first rw/ro is where a shell starts when the cwd is outside all of them.
#
# Why the file is outside the projects and not a dotfile in one: project
# directories are mounted read-write, so an agent could edit such a file and
# grant itself more directories on the next start. The config is read here, on
# the host, and a config lying inside any mounted directory is refused. It is
# parsed line by line and never `source`d: it is data, and sourcing would be a
# second way to run arbitrary code on the host.

conf_dir="${XDG_CONFIG_HOME:-$HOME/.config}/agent-sandbox/projects"

cfg_name=""
cfg_file=""
cfg_mounts=()   # "path" or "path:ro"
cfg_account=""
cfg_env=()
cfg_autostart=()
cfg_publish=()

cfg_path() { # expand a leading ~ and resolve to a physical dir, or die
  local p="$1"
  # shellcheck disable=SC2088  # matching a literal "~/" prefix on purpose
  case "$p" in "~") p="$HOME" ;; "~/"*) p="$HOME/${p#"~/"}" ;; esac
  case "$p" in
    *:*) die "path in $cfg_file must not contain ':' (breaks the podman -v spec): $p" ;;
  esac
  [ -d "$p" ] || die "not a directory (in $cfg_file): $p"
  p="$(cd "$p" && pwd -P)"
  # Mounting / or the whole home would hand the agent SSH keys, browser
  # profiles and every other project -- what the sandbox exists to hide.
  if [ "$p" = / ] || [ "$p" = "$(cd "$HOME" && pwd -P)" ]; then
    die "refusing to mount $p (from $cfg_file) -- list project directories"
  fi
  printf '%s' "$p"
}

load_config() { # load_config <name> -> fills the cfg_* globals
  cfg_name="$1"
  case "$cfg_name" in
    "" | *[!a-z0-9_-]* | [_-]*) die "config name must be [a-z0-9_-]: @$cfg_name" ;;
  esac
  cfg_file="$conf_dir/$cfg_name.conf"
  [ -f "$cfg_file" ] || die "no config $cfg_file"
  cfg_mounts=(); cfg_account=""; cfg_env=(); cfg_autostart=(); cfg_publish=()
  local line lineno=0 key val
  while IFS= read -r line || [ -n "$line" ]; do
    lineno=$((lineno + 1))
    line="${line%%#*}"
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [ -n "$line" ] || continue
    case "$line" in
      *=*) ;;
      *) die "$cfg_file:$lineno: expected 'key = value'" ;;
    esac
    key="${line%%=*}"; key="${key%"${key##*[![:space:]]}"}"
    val="${line#*=}"; val="${val#"${val%%[![:space:]]*}"}"
    case "$key" in
      rw) cfg_mounts+=("$(cfg_path "$val")") ;;
      ro) cfg_mounts+=("$(cfg_path "$val"):ro") ;;
      account)
        case "$val" in "" | *[!a-z0-9_-]* | [_-]*) die "$cfg_file:$lineno: account must be [a-z0-9_-]" ;; esac
        cfg_account="$val"
        ;;
      publish)
        case "$val" in
          [0-9]*:[0-9]*) ;;
          *) die "$cfg_file:$lineno: publish expects <host-port>:<container-port>" ;;
        esac
        case "${val%%:*}${val#*:}" in *[!0-9]*) die "$cfg_file:$lineno: publish expects numeric ports" ;; esac
        cfg_publish+=("$val")
        ;;
      autostart) cfg_autostart+=("$val") ;;
      env)
        case "$val" in
          [A-Za-z_]*=*) cfg_env+=("$val") ;;
          *) die "$cfg_file:$lineno: env expects NAME=value" ;;
        esac
        ;;
      *) die "$cfg_file:$lineno: unknown key '$key'" ;;
    esac
  done <"$cfg_file"
  [ "${#cfg_mounts[@]}" -gt 0 ] || die "$cfg_file lists no 'rw = ...' directory"
  # The config must not be reachable (writable) from inside the container.
  local cfg_real m
  cfg_real="$(cd "$(dirname "$cfg_file")" && pwd -P)/$(basename "$cfg_file")"
  for m in "${cfg_mounts[@]}"; do
    m="${m%:ro}"
    case "$cfg_real" in
      "$m"/*) die "$cfg_file lies inside mounted dir $m -- an agent could rewrite it; move it out" ;;
    esac
  done
}

# Longest mount of the loaded config that contains $1, or nothing.
config_match_len() {
  local m best=0
  for m in "${cfg_mounts[@]}"; do
    m="${m%:ro}"
    case "$1/" in "$m"/*) [ "${#m}" -le "$best" ] || best="${#m}" ;; esac
  done
  [ "$best" -eq 0 ] || echo "$best"
}

# Which sandbox covers the cwd? Every config is loaded in a subshell: a
# broken or unrelated config must neither abort the search nor leak state.
# The longest matching mount wins (a sandbox for ~/code/work/rnds beats one
# that lists ~/code/work).
here="$(pwd -P)"
if [ "$here_mode" = 1 ]; then
  [ -z "$target" ] || die "--here and @name exclude each other"
  [ -z "$start_dir" ] || die "--here: -C makes no sense (the directory IS the cwd)"
  # One-off sandbox for exactly this directory, no config file. Why it exists:
  # any folder (this repo, a clone you just made) must be openable with an
  # agent without first editing a config. Same trust model as a config with a
  # single `rw =` line; the checks of cfg_path (not / or $HOME) apply.
  # Name: basename + hash of the path, so two folders called "app" differ and
  # the same folder always lands in the same container.
  cfg_file="--here"
  cfg_mounts=("$(cfg_path "$here")")
  cfg_account=""; cfg_env=(); cfg_autostart=(); cfg_publish=()
  hash="$(printf '%s' "$here" | sha256sum | cut -c1-8)"
  base="$(basename "$here" | tr 'A-Z.' 'a-z-' | tr -c 'a-z0-9_\n-' '-' | cut -c1-24)"
  cfg_name="here-${base#[-_]}-$hash"
  # One shared set of volumes for all one-off sandboxes: home, toolchains and
  # npm are downloaded once, not per folder.
  vol_name="adhoc"
else
if [ -z "$target" ]; then
  best_len=0
  for f in "$conf_dir"/*.conf; do
    [ -f "$f" ] || continue
    n="$(basename "$f" .conf)"
    len="$( (load_config "$n" && config_match_len "$here") 2>/dev/null || true)"
    if [ -n "$len" ] && [ "$len" -gt "$best_len" ]; then best_len="$len"; target="$n"; fi
  done
  if [ -z "$target" ]; then
    [ "$mode" != which ] || exit 1
    die "no sandbox config covers $here -- pick one with @name, list this directory in a config under $conf_dir, or use --here"
  fi
fi
load_config "$target"
vol_name="$cfg_name"
fi
if [ "$mode" = which ]; then echo "$cfg_name"; exit 0; fi

container_name="agent-sandbox-cfg-$cfg_name"

running() {
  [ "$(podman container inspect -f '{{.State.Running}}' "$container_name" 2>/dev/null || true)" = true ]
}

# ---------------------------------------------------------------------------
# down
# ---------------------------------------------------------------------------
if [ "$mode" = down ]; then
  # `up` starts the container with --rm: stopping removes it, the named
  # volumes (home, cache, toolchains) stay.
  exec podman stop "$container_name"
fi

# ---------------------------------------------------------------------------
# Where does the command start? Always a host path (identical inside).
# ---------------------------------------------------------------------------
first_mount="${cfg_mounts[0]%:ro}"
workdir="$here"
if [ -n "$start_dir" ]; then
  [ -d "$start_dir" ] || die "-C: not a directory: $start_dir"
  workdir="$(cd "$start_dir" && pwd -P)"
fi
inside=0
for m in "${cfg_mounts[@]}"; do
  m="${m%:ro}"
  case "$workdir/" in "$m"/*) inside=1 ;; esac
done
if [ "$inside" = 0 ]; then
  # Run from outside the group (e.g. `agent-sandbox @work` from ~): start
  # at its first project. An explicit -C pointing outside is an error: the
  # entrypoint would refuse it anyway, less clearly.
  [ -z "$start_dir" ] || die "-C $workdir is not inside the sandbox's directories"
  workdir="$first_mount"
fi

# ---------------------------------------------------------------------------
# Container creation (up, or the implicit up of `enter`)
# ---------------------------------------------------------------------------

# The sandbox root: a directory in /nix/store, not an image
# (modules/nixos/packages/agent-sandbox.nix). The host module links it at
# /etc/agent-sandbox/rootfs; AGENT_SANDBOX_ROOTFS points at a build for
# testing without a switch (`nix build .#agent-sandbox-rootfs`). Resolved to
# the real store path: podman --rootfs needs a directory, and a later switch
# must not change it under a running container.
resolve_rootfs() {
  local link="${AGENT_SANDBOX_ROOTFS:-/etc/agent-sandbox/rootfs}"
  rootfs="$(readlink -f "$link" 2>/dev/null || true)"
  if [ -z "$rootfs" ] || [ ! -e "$rootfs/agent-entrypoint" ]; then
    die "no sandbox rootfs at $link -- enable modules/nixos/agent-sandbox.nix (nixos-rebuild switch)" \
        "or point AGENT_SANDBOX_ROOTFS at a build"
  fi
}

start_container() {
  local d m e p mounts_env=() args

  # Environment passthrough is an explicit allowlist, never --env-host /
  # --env-file: the container gets exactly what is named here. In particular
  # Jira/GitLab/other service tokens exported in the host shell never reach
  # an agent that reads untrusted ticket text over an open network
  # (system-plan.md §9.7). tests/agent-sandbox-test.sh asserts this.
  # `-e VAR` without =value forwards the host's value; only added when set,
  # so an unset variable does not become an empty one inside.
  local env_args=()
  [ -z "${ANTHROPIC_API_KEY:-}" ] || env_args+=(-e ANTHROPIC_API_KEY)
  # dsh refuses to do anything without a DeepSeek key.
  [ -z "${DEEPSEEK_API_KEY:-}" ] || env_args+=(-e DEEPSEEK_API_KEY)
  # GitLab: opt-in per creation, never implicit. For a *Project* Access
  # Token only (one project, Developer role, expiry, protected main); a
  # broader personal token must not be passed (system-plan.md §9.7).
  if [ "$gitlab_token" = 1 ]; then
    [ -n "${GITLAB_TOKEN:-}" ] || die "--gitlab-token given but GITLAB_TOKEN is not set"
    env_args+=(-e GITLAB_TOKEN)
  fi
  for e in ${cfg_env[@]+"${cfg_env[@]}"}; do env_args+=(-e "$e"); done

  # Claude accounts (bin/claude-use): the whole root is mounted, so
  # `claude-use <account>` on the host switches the agents in here too, and
  # sessions are shared with the host. Both accounts' logins are therefore
  # readable inside every sandbox -- the accounts are yours, and the
  # alternative (one account per sandbox) is the logout/login dance this
  # exists to avoid. `account =` in the config only picks the default.
  local claude_root="${CLAUDE_ACCOUNTS_ROOT:-$HOME/.local/share/claude-accounts}"
  local claude_args=()
  if [ -d "$claude_root" ]; then
    claude_root="$(cd "$claude_root" && pwd -P)"
    claude_args+=(-v "$claude_root:$claude_root" -e "CLAUDE_ACCOUNTS_ROOT=$claude_root")
    [ -z "$cfg_account" ] || [ -d "$claude_root/$cfg_account" ] ||
      die "$cfg_file: account '$cfg_account' does not exist in $claude_root (claude-use --add $cfg_account)"
  elif [ -n "$cfg_account" ]; then
    die "$cfg_file: account '$cfg_account' needs $claude_root (claude-use --add $cfg_account)"
  fi
  # A --here sandbox has no config to say `account =`, and the rules file
  # (~/.config/claude-accounts/rules) is not visible inside the container, so
  # resolve the account HERE from the folder (cwd = the mounted folder) and
  # hand the result in, exactly as `account =` would. Without this the
  # sandbox answered "no account selected" and claude asked to log in.
  if [ "$here_mode" = 1 ] && [ -z "$cfg_account" ] && command -v claude-use >/dev/null 2>&1; then
    cfg_account="$(claude-use resolve 2>/dev/null | cut -f1 || true)"
    case "$cfg_account" in *[!a-z0-9_-]*) cfg_account="" ;; esac
  fi
  [ -z "$cfg_account" ] || claude_args+=(-e "CLAUDE_ACCOUNT_DEFAULT=$cfg_account")

  args=(
    podman run --rm -d
    --name "$container_name"
    --label "agent-sandbox.name=$cfg_name"
    # PID 1 of a long-lived container must reap orphans (tmux servers,
    # agent CLIs detached from their exec); `sleep` would not. --init puts
    # podman's catatonit there.
    --init
    --userns=keep-id
    # Per-sandbox persistent HOME. Containers are --rm, so without it shell
    # history, ~/.gitconfig, ~/.dsh (dsh plugins/sessions), tool configs and
    # opencode's login vanish on every down/up. The volumes below are
    # mounted over it at their subpaths (podman mounts parents first).
    # The image's own /home/agent is empty (chmod 777), so the volume never
    # freezes stale image content.
    -v "agent-home-$vol_name:/home/agent"
    # Toolchains: per sandbox, not shared across sandboxes. They used to be
    # one volume for everything, which let a compromised agent in project A
    # replace a runtime or shim that later ran in project B (system-plan.md
    # §9.6). With two sandboxes of different trust (work / personal) that
    # channel is not worth the saved disk. They live under /shared, NOT in
    # the home directory: nested under ~/.local/share podman created ~/.local
    # as a root-owned mount-point parent and every tool writing there failed
    # with EACCES (opencode, seen in the VM).
    -v "agent-mise-$vol_name:/shared/mise"
    -v "agent-uv-tools-$vol_name:/shared/uv"
    -v "agent-npm-global-$vol_name:/shared/npm-global"
    -v "agent-cache-$vol_name:/home/agent/.cache"
    --network=bridge
  )
  args+=(${env_args[@]+"${env_args[@]}"} ${claude_args[@]+"${claude_args[@]}"})
  for p in ${cfg_publish[@]+"${cfg_publish[@]}"}; do
    # Always 127.0.0.1, never 0.0.0.0: a web UI next to an agent (dsh web, a
    # board) must not be reachable from the LAN.
    args+=(-p "127.0.0.1:${p%%:*}:${p#*:}")
  done

  # The projects. AGENT_MOUNTS tells the entrypoint which paths are project
  # dirs: mise trusts their config and the start directory is validated
  # against them.
  for m in "${cfg_mounts[@]}"; do
    d="${m%:ro}"
    if [ "$m" = "$d" ]; then args+=(-v "$d:$d"); else args+=(-v "$d:$d:ro"); fi
    mounts_env+=("$d")
  done
  args+=(-e "AGENT_MOUNTS=$(IFS=:; echo "${mounts_env[*]}")")

  if [ "$gui" = 1 ]; then
    # `readlink -f "${BASH_SOURCE[0]}"`, not `dirname "$0"`: $0 is the
    # invoking name, a symlink if agent-sandbox was put on PATH through one.
    # shellcheck disable=SC1091
    source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/agent-sandbox-gui.sh"
  fi

  # Run from the rootfs directory instead of an image:
  # - --rootfs DIR:O -- ":O" overlays it, so podman can create its mount
  #   points (/etc/hosts, ...) although DIR is in the read-only store;
  # - /nix/store read-only: every tool and symlink in the rootfs points into
  #   it -- the host's own store, shared, not copied;
  # - /tmp as a host directory (the rootfs is read-only): disk-backed, not
  #   RAM -- Go caches, build dirs and pgdata took ~4 GB of tmpfs (seen
  #   2026-10-20). Wiped on every `up`, so it stays as ephemeral as the tmpfs
  #   it replaces. Not an anonymous volume: that one is not writable by the
  #   keep-id user (checked: "Permission denied");
  # - /etc/passwd and /etc/group generated here, mounted read-only:
  #   getpwuid() must work for git/ssh/mise. Letting podman append the
  #   keep-id user fails: the rootfs files belong to the host's root, which
  #   is unmapped in a rootless user namespace (first run in the VM);
  # - /agent-entrypoint is called explicitly: a rootfs has no image config.
  resolve_rootfs
  local ids_dir="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/agent-sandbox"
  mkdir -p "$ids_dir"
  local tmp_dir="${XDG_CACHE_HOME:-$HOME/.cache}/agent-sandbox/tmp-$vol_name"
  rm -rf "$tmp_dir"
  mkdir -p "$tmp_dir"
  chmod 1777 "$tmp_dir"
  printf 'root:x:0:0:root:/root:/bin/sh\nagent:x:%s:%s:agent:/home/agent:/bin/bash\n' \
    "$(id -u)" "$(id -g)" >"$ids_dir/passwd"
  printf 'root:x:0:\nagent:x:%s:\nnogroup:x:65534:\n' "$(id -g)" >"$ids_dir/group"
  args+=(
    -v /nix/store:/nix/store:ro
    -v "$ids_dir/passwd:/etc/passwd:ro"
    -v "$ids_dir/group:/etc/group:ro"
    -v "$tmp_dir:/tmp"
  )
  # Host language runtimes, read-only, at the same path (binstubs and
  # shebangs hold absolute paths): mise finds them via MISE_SHARED_INSTALL_DIRS
  # and never writes there, so nothing is downloaded twice and an agent
  # cannot alter what later runs on the host.
  local host_mise="${MISE_DATA_DIR:-$HOME/.local/share/mise}/installs"
  if [ -d "$host_mise" ]; then
    host_mise="$(cd "$host_mise" && pwd -P)"
    args+=(-v "$host_mise:$host_mise:ro" -e "MISE_SHARED_INSTALL_DIRS=$host_mise")
  fi
  # The container's own command only keeps it alive; everything useful runs
  # through `podman exec`. It still passes the entrypoint, so mise installs
  # for the first project once, here.
  # --rootfs goes LAST among the options, after every -v/-e: with it earlier
  # and the host-mise -v after it, podman 5.8.9 started the container but
  # catatonit died with "failed to exec pid1: No such file or directory", so
  # `up` ended in "can only create exec sessions on running containers"
  # (found 2026-10-19 on @work-rnds by bisecting the logged `podman run`:
  # same args, only the position of --rootfs differed). Cause not pinned
  # down; the position is the empirically working one.
  args+=(--rootfs "$rootfs:O")
  args+=(/agent-entrypoint sleep infinity)
  "${args[@]}"

  # Loopback proxy relay. podman copies the host's HTTP(S)_PROXY into the
  # container by itself (--http-proxy=true by default), but a value like
  # http://127.0.0.1:2080 (Throne) then points at the container's OWN
  # loopback, where nothing listens: `npx` inside got ECONNREFUSED, so
  # kandev could not download @agentclientprotocol/claude-agent-acp and
  # every agent start failed with "ACP initialize ... peer disconnected"
  # (found 2026-10-20 on @work-rnds). host.containers.internal reaches the
  # host's loopback services (verified: its :2080 connects), so a socat on
  # the same port inside the container makes the copied variable valid
  # unchanged. Started before the autostart commands, which may need the net.
  local px="${HTTPS_PROXY:-${HTTP_PROXY:-}}" pxport
  if [[ "$px" =~ ^https?://(127\.0\.0\.1|localhost):([0-9]+)/?$ ]]; then
    pxport="${BASH_REMATCH[2]}"
    podman exec -d "$container_name" /agent-entrypoint sh -c \
      "socat TCP-LISTEN:$pxport,fork,reuseaddr,bind=127.0.0.1 TCP:host.containers.internal:$pxport >> /home/agent/.local-state/autostart.log 2>&1"
  fi

  # autostart: boards/services inside the same container, detached; output
  # in ~/.local-state/autostart.log inside the sandbox.
  local cmd
  for cmd in ${cfg_autostart[@]+"${cfg_autostart[@]}"}; do
    podman exec -d "$container_name" /agent-entrypoint sh -c "$cmd >> /home/agent/.local-state/autostart.log 2>&1"
  done
}

if [ "$mode" = up ]; then
  if running; then
    echo "agent-sandbox: already running: $container_name" >&2
    exit 0
  fi
  start_container
  exit 0
fi

# ---------------------------------------------------------------------------
# enter: run a command in the sandbox (starting it if needed)
# ---------------------------------------------------------------------------
if running; then
  if [ "$gui" = 1 ] || [ "$gitlab_token" = 1 ]; then
    die "--gui/--gitlab-token are fixed when the sandbox is created; it is already running (agent-sandbox down @$cfg_name first)"
  fi
else
  start_container
fi

# TTY only when both stdin and stdout are terminals: a forced -t breaks the
# non-interactive form used from scripts (mangled output, "the input device
# is not a TTY"). --no-tty forces the plain path even from a terminal, for
# an orchestrator started interactively that wants clean stream-json.
if [ "$no_tty" = 0 ] && [ -t 0 ] && [ -t 1 ]; then
  tty_args=(-it)
else
  tty_args=(-i)
fi

# `podman exec` does not run the image Entrypoint, so the command goes
# through it explicitly (HOME, PATH to the toolchain volumes, nix-ld and
# mise would be missing otherwise). The exit status of the command is podman
# exec's own (podman uses 125-127 only for its own errors).
exec podman exec "${tty_args[@]}" -e "AGENT_WORKDIR=$workdir" "$container_name" /agent-entrypoint "$@"
